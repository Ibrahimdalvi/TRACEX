    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { ActiveView } from \'../../types\';\n\ninterface SidebarProps {\n  activeView: ActiveView;\n  onSelectView: (view: ActiveView) => void;\n  onOpenSystemStatus: () => void;\n  unreadAlertsCount?: number;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activeView,\n  onSelectView,\n  onOpenSystemStatus,\n  unreadAlertsCount = 3,\n}) => {\n  const navItems: Array<{\n    id: ActiveView;\n    label: string;\n    icon: string;\n    badge?: number;\n  }> = [\n    { id: \'command-center\', label: \'COMMAND CENTER\', icon: \'dashboard\' },\n    { id: \'investigations\', label: \'INVESTIGATIONS\', icon: \'search_check\' },\n    { id: \'network\', label: \'NETWORK\', icon: \'hub\' },\n    { id: \'intelligence\', label: \'INTELLIGENCE\', icon: \'psychology\' },\n    { id: \'evidence\', label: \'EVIDENCE\', icon: \'folder_open\' },\n    { id: \'entities\', label: \'ENTITIES\', icon: \'groups\' },\n    { id: \'timeline\', label: \'TIMELINE\', icon: \'history\' },\n    { id: \'alerts\', label: \'ALERTS\', icon: \'notifications_active\', badge: unreadAlertsCount },\n    { id: \'reports\', label: \'REPORTS\', icon: \'description\' },\n  ];\n\n  return (\n    <aside className=\"fixed left-0 top-0 h-screen w-72 bg-[#090f0f] border-r border-[#3c4948]/30 flex flex-col py-3 z-50 shadow-2xl select-none\">\n      {/* Brand Header */}\n      <div className=\"px-6 mb-6\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded bg-[#242b2a] flex items-center justify-center border border-[#3c4948]/40 shadow-inner\">\n            <span className=\"material-symbols-outlined text-[#66FCF1]\" style={{ fontSize: \'22px\' }}>\n              security\n            </span>\n          </div>\n          <div>\n            <h1 className=\"font-sans text-2xl font-extrabold tracking-tighter text-white flex items-center gap-1.5\">\n              ARGUS\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#66FCF1] animate-pulse inline-block\"></span>\n            </h1>\n            <p className=\"font-mono text-[10px] font-bold tracking-widest text-[#bacac7] uppercase\">\n              CRIMINAL INTEL\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* AI Copilot Action Button */}\n      <div className=\"px-5 mb-4\">\n        <button\n          onClick={() => onSelectView(\'alerts\')}\n          className={`w-full py-2.5 px-3 font-mono text-[11px] font-bold uppercase tracking-wider rounded flex items-center justify-center gap-2 transition-all duration-200 shadow-md ${\n            activeView === \'alerts\'\n              ? \'bg-[#66FCF1] text-[#00201e] border border-[#66FCF1] shadow-[0_0_15px_rgba(102,252,241,0.3)]\'\n              : \'bg-[#1a2120] text-[#66FCF1] border border-[#66FCF1]/40 hover:bg-[#66FCF1] hover:text-[#00201e] hover:border-[#66FCF1]\'\n          }`}\n        >\n          <span className=\"material-symbols-outlined text-[18px]\">smart_toy</span>\n          AI COPILOT\n          <span className=\"w-2 h-2 rounded-full bg-[#ffb4ab] animate-ping ml-auto\"></span>\n        </button>\n      </div>\n\n      {/* Main Navigation Links */}\n      <nav className=\"flex-1 flex flex-col gap-1 px-3 overflow-y-auto\">\n        {navItems.map((item) => {\n          const isActive = activeView === item.id;\n          return (\n            <button\n              key={item.id}\n              onClick={() => onSelectView(item.id)}\n              className={`flex items-center justify-between px-3 py-2.5 rounded transition-all text-left group ${\n                isActive\n                  ? \'text-white bg-[#62f9ee]/10 border-l-[3px] border-[#66FCF1] shadow-sm\'\n                  : \'text-[#bacac7] hover:bg-[#242b2a] hover:text-white\'\n              }`}\n            >\n              <div className=\"flex items-center gap-3\">\n                <span\n                  className={`material-symbols-outlined transition-colors ${\n                    isActive ? \'text-[#66FCF1]\' : \'text-[#859491] group-hover:text-[#66FCF1]\'\n                  }`}\n                  style={{ fontSize: \'20px\' }}\n                >\n                  {item.icon}\n                </span>\n                <span\n                  className={`font-mono text-[10px] tracking-wider uppercase font-semibold ${\n                    isActive ? \'text-white font-bold\' : \'text-[#bacac7]\'\n                  }`}\n                >\n                  {item.label}\n                </span>\n              </div>\n\n              {item.badge && item.badge > 0 && (\n                <span className=\"px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-[#93000a] text-[#ffdad6] border border-[#ffb4ab]/30\">\n                  {item.badge}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </nav>\n\n      {/* System Status Footer */}\n      <div className=\"px-5 mt-auto border-t border-[#3c4948]/30 pt-3\">\n        <button\n          onClick={onOpenSystemStatus}\n          className=\"w-full flex items-center gap-3 py-2 px-2 text-[#859491] hover:text-[#66FCF1] hover:bg-[#1a2120] rounded transition-colors text-left font-mono text-[10px] tracking-wider uppercase\"\n        >\n          <span className=\"material-symbols-outlined text-[#66FCF1] text-[18px] animate-pulse\">\n            sensors\n          </span>\n          <span>SYSTEM STATUS</span>\n          <span className=\"ml-auto text-[9px] text-[#7bd6d1] bg-[#007774]/20 px-1.5 py-0.5 rounded border border-[#007774]/40\">\n            ONLINE\n          </span>\n        </button>\n      </div>\n    </aside>\n  );\n};\n"
    }

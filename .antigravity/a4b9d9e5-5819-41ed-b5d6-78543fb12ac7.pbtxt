  file_change {
    absolute_path_uri: "file:///src/components/views/CaseInvestigationView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { InvestigationCase, ActiveView } from \'../../types\';\n\ninterface CaseInvestigationViewProps {\n  currentCase: InvestigationCase;\n  onNavigate: (view: ActiveView) => void;\n  onOpenExportDossier: () => void;\n  onOpenSubpoenaModal: () => void;\n  onTriggerDeepScan: () => void;\n  isScanning?: boolean;\n}\n\nexport const CaseInvestigationView: React.FC<CaseInvestigationViewProps> = ({\n  currentCase,\n  onNavigate,\n  onOpenExportDossier,\n  onOpenSubpoenaModal,\n  onTriggerDeepScan,\n  isScanning = false,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'OVERVIEW\' | \'EVIDENCE\' | \'ENTITIES\' | \'NETWORK\' | \'TIMELINE\' | \'INSIGHTS\'>(\'OVERVIEW\');\n\n  const tabs: Array<\'OVERVIEW\' | \'EVIDENCE\' | \'ENTITIES\' | \'NETWORK\' | \'TIMELINE\' | \'INSIGHTS\'> = [\n    \'OVERVIEW\',\n    \'EVIDENCE\',\n    \'ENTITIES\',\n    \'NETWORK\',\n    \'TIMELINE\',\n    \'INSIGHTS\',\n  ];\n\n  return (\n    <div className=\"flex-1 flex flex-col overflow-y-auto pr-2 pb-12\">\n      {/* Page Header */}\n      <div className=\"mb-6\">\n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4\">\n          <div>\n            <div className=\"flex items-center gap-3 mb-1.5\">\n              <span className=\"font-mono text-sm font-bold text-[#7bd6d1]\">{currentCase.id}</span>\n              <span className=\"px-2.5 py-0.5 rounded bg-[#62f9ee]/10 border border-[#62f9ee]/30 text-[#62f9ee] font-mono text-[10px] font-bold flex items-center gap-1.5 shadow-sm\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-[#62f9ee] animate-pulse\"></span>\n                ACTIVE\n              </span>\n            </div>\n            <h2 className=\"font-sans text-2xl sm:text-3xl font-bold text-white tracking-tight\">\n              {currentCase.title}\n            </h2>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <button\n              onClick={onOpenExportDossier}\n              className=\"px-4 py-2 border border-[#3c4948]/70 rounded bg-[#1a2120] text-[#dde4e2] font-mono text-[10px] font-bold uppercase tracking-wider hover:bg-[#242b2a] hover:border-[#66FCF1]/60 transition-all flex items-center gap-2 shadow-sm\"\n            >\n              <span className=\"material-symbols-outlined text-[16px] text-[#66FCF1]\">download</span>\n              EXPORT DOSSIER\n            </button>\n          </div>\n        </div>\n\n        {/* Investigation Tabs */}\n        <div className=\"flex gap-1 border-b border-[#3c4948]/30 overflow-x-auto\">\n          {tabs.map((tab) => {\n            const isActive = activeTab === tab;\n            return (\n              <button\n                key={tab}\n                onClick={() => {\n                  setActiveTab(tab);\n                  if (tab === \'NETWORK\') onNavigate(\'network\');\n                  if (tab === \'EVIDENCE\') onNavigate(\'evidence\');\n                  if (tab === \'ENTITIES\') onNavigate(\'entities\');\n                  if (tab === \'TIMELINE\') onNavigate(\'timeline\');\n                  if (tab === \'INSIGHTS\') onNavigate(\'intelligence\');\n                }}\n                className={`px-4 py-3 font-mono text-[10px] font-bold tracking-widest transition-all whitespace-nowrap ${\n                  isActive\n                    ? \'text-white border-b-2 border-white shadow-sm\'\n                    : \'text-[#859491] hover:text-white hover:bg-[#1a2120]/50\'\n                }`}\n              >\n                {tab}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Dashboard Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Left Column (8 Cols) */}\n        <div className=\"lg:col-span-8 flex flex-col gap-6\">\n          {/* Summary Card */}\n          <div className=\"bg-[#1a2120] border border-[#3c4948]/40 rounded-lg p-5 relative overflow-hidden shadow-sm\">\n            <div className=\"flex flex-col md:flex-row gap-6 items-start\">\n              <div className=\"flex-1\">\n                <h3 className=\"font-sans text-base font-bold text-white mb-2\">\n                  Investigation Summary\n                </h3>\n                <p className=\"font-sans text-xs sm:text-sm text-[#bacac7] leading-relaxed\">\n                  {currentCase.summary}\n                </p>\n              </div>\n\n              {/* Progress Radial Metric */}\n              <div className=\"flex flex-col items-center justify-center min-w-[120px] p-4 bg-[#0e1514] rounded border border-[#3c4948]/30 self-center md:self-auto shadow-inner\">\n                <div className=\"relative w-20 h-20 mb-1.5\">\n                  <svg className=\"w-full h-full transform -rotate-90\" viewBox=\"0 0 36 36\">\n                    <path\n                      className=\"text-[#3c4948]/40 stroke-current\"\n                      d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                      fill=\"none\"\n                      strokeWidth=\"3\"\n                    />\n                    <path\n                      className=\"text-[#62f9ee] stroke-current transition-all duration-1000\"\n                      d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\"\n                      fill=\"none\"\n                      strokeDasharray={`${currentCase.progress}, 100`}\n                      strokeWidth=\"3\"\n                    />\n                  </svg>\n                  <div className=\"absolute inset-0 flex flex-col items-center justify-center\">\n                    <span className=\"font-mono text-base font-bold text-white\">\n                      {currentCase.progress}%\n                    </span>\n                  </div>\n                </div>\n                <span className=\"font-mono text-[9px] font-bold tracking-widest text-[#859491] uppercase\">\n                  PROGRESS\n                </span>\n              </div>\n            </div>\n          </div>\n\n          {/* Key Entities Grid */}\n          <div>\n            <div className=\"flex justify-between items-center mb-3\">\n              <h3 className=\"font-sans text-base font-bold text-white\">Key Entities</h3>\n              <button\n                onClick={() => onNavigate(\'entities\')}\n                className=\"font-mono text-[10px] font-bold text-[#62f9ee] hover:underline flex items-center gap-1 uppercase tracking-wider\"\n              >\n                VIEW ALL <span className=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n              </button>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              {/* Target Entity Card */}\n              <div className=\"bg-[#1a2120] border border-[#93000a]/40 border-l-4 border-l-[#ffb4ab] rounded-lg p-4 flex flex-col shadow-sm\">\n                <div className=\"flex justify-between items-start mb-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-[#62f9ee] text-[18px]\">person</span>\n                    <span className=\"font-mono text-[11px] text-[#62f9ee] bg-[#62f9ee]/10 px-2 py-0.5 rounded border border-[#62f9ee]/20 font-bold\">\n                      P-104\n                    </span>\n                  </div>\n                  <span className=\"px-2 py-0.5 text-[9px] uppercase tracking-widest font-extrabold bg-[#93000a]/30 text-[#ffdad6] rounded border border-[#ffb4ab]/30\">\n                    PRIMARY TARGET\n                  </span>\n                </div>\n\n                <h4 className=\"font-sans text-base font-bold text-white mb-2\">Rahul Sharma</h4>\n\n                <div className=\"grid grid-cols-2 gap-y-3 gap-x-2 mt-1\">\n                  <div>\n                    <p className=\"font-mono text-[9px] font-bold text-[#859491] uppercase tracking-wider mb-0.5\">\n                      ROLE\n                    </p>\n                    <p className=\"font-sans text-xs text-white font-medium\">Director</p>\n                  </div>\n                  <div>\n                    <p className=\"font-mono text-[9px] font-bold text-[#859491] uppercase tracking-wider mb-0.5\">\n                      LOCATION\n                    </p>\n                    <p className=\"font-sans text-xs text-white font-medium\">Dubai, UAE</p>\n                  </div>\n                  <div>\n                    <p className=\"font-mono text-[9px] font-bold text-[#859491] uppercase tracking-wider mb-0.5\">\n                      DOB\n                    </p>\n                    <p className=\"font-mono text-xs text-white\">14-MAY-1978</p>\n                  </div>\n                  <div>\n                    <p className=\"font-mono text-[9px] font-bold text-[#859491] uppercase tracking-wider mb-0.5\">\n                      NATIONALITY\n                    </p>\n                    <p className=\"font-sans text-xs text-white font-medium\">Indian</p>\n                  </div>\n                </div>\n              </div>\n\n              {/* Secondary Entity: Shell Company */}\n              <div className=\"bg-[#1a2120] border border-[#3c4948]/40 rounded-lg p-4 flex flex-col hover:bg-[#242b2a]/50 transition-colors shadow-sm\">\n                <div className=\"flex justify-between items-start mb-3\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-[#859491] text-[18px]\">account_balance</span>\n                    <span className=\"font-mono text-[11px] text-[#bacac7] bg-[#2f3635] px-2 py-0.5 rounded border border-[#3c4948]/40 font-bold\">\n                      ORG-42\n                    </span>\n                  </div>\n                  <span className=\"px-2 py-0.5 text-[9px] uppercase tracking-widest font-extrabold bg-[#736400]/20 text-[#fce363] rounded border border-[#fce363]/30\">\n                    SHELL CO.\n                  </span>\n                </div>\n\n                <h4 className=\"font-sans text-base font-bold text-white mb-2\">Aegis Holdings FZE</h4>\n\n                <div className=\"grid grid-cols-2 gap-y-3 gap-x-2 mt-1\">\n                  <div>\n                    <p className=\"font-mono text-[9px] font-bold text-[#859491] uppercase tracking-wider mb-0.5\">\n                      REG. DATE\n                    </p>\n                    <p className=\"font-mono text-xs text-white\">12-AUG-2024</p>\n                  </div>\n                  <div>\n                    <p className=\"font-mono text-[9px] font-bold text-[#859491] uppercase tracking-wider mb-0.5\">\n                      STATUS\n                    </p>\n                    <p className=\"font-sans text-xs text-[#7bd6d1] font-medium\">Active</p>\n                  </div>\n                  <div>\n                    <p className=\"font-mono text-[9px] font-bold text-[#859491] uppercase tracking-wider mb-0.5\">\n                      JURISDICTION\n                    </p>\n                    <p className=\"font-sans text-xs text-white font-medium\">UAE (DMCC)</p>\n                  </div>\n                  <div>\n                    <p className=\"font-mono text-[9px] font-bold text-[#859491] uppercase tracking-wider mb-0.5\">\n                      BENEFICIAL OWNER\n                    </p>\n                    <p className=\"font-mono text-xs text-[#62f9ee] font-semibold\">P-104</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Activity Feed */}\n          <div className=\"bg-[#1a2120] border border-[#3c4948]/40 rounded-lg p-5 shadow-sm\">\n            <h3 className=\"font-sans text-base font-bold text-white mb-4 flex items-center gap-2\">\n              <span className=\"material-symbols-outlined text-[#7bd6d1] text-[18px]\">list_alt</span>\n              Recent Activity\n            </h3>\n\n            <div className=\"flex flex-col divide-y divide-[#3c4948]/30\">\n              {currentCase.recentActivity.map((act) => (\n                <div\n                  key={act.id}\n                  className=\"flex gap-4 py-3 hover:bg-[#242b2a]/40 px-2 -mx-2 rounded transition-colors\"\n                >\n                  <div className=\"mt-0.5\">\n                    <span\n                      className=\"material-symbols-outlined text-[16px] p-1.5 rounded flex items-center justify-center\"\n                      style={{ backgroundColor: act.iconBg, color: act.iconColor }}\n                    >\n                      {act.icon}\n                    </span>\n                  </div>\n                  <div className=\"flex-1\">\n                    <p className=\"font-sans text-xs sm:text-sm text-[#dde4e2] font-medium leading-snug\">\n                      {act.text}\n                    </p>\n                    <p className=\"font-mono text-[10px] text-[#859491] mt-1 font-semibold\">\n                      {act.subtext}\n                    </p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column (4 Cols) */}\n        <div className=\"lg:col-span-4 flex flex-col gap-6\">\n          {/* AI Assessment Panel */}\n          <div className=\"bg-[#1a2120] border border-[#3c4948]/40 rounded-lg p-5 relative overflow-hidden flex flex-col h-full shadow-sm\">\n            <div className=\"flex items-center gap-2 mb-4 pb-3 border-b border-[#3c4948]/40\">\n              <span className=\"material-symbols-outlined text-[#7bd6d1] text-[20px]\">analytics</span>\n              <h3 className=\"font-sans text-base font-bold text-white\">Technical Assessment</h3>\n            </div>\n\n            <div className=\"mb-4\">\n              <div className=\"flex items-center justify-between mb-2.5\">\n                <span className=\"font-mono text-[10px] font-extrabold text-[#ffb4ab] border border-[#ffb4ab]/30 bg-[#93000a]/20 px-2 py-0.5 rounded tracking-wider uppercase\">\n                  {currentCase.assessment.riskLevel}\n                </span>\n                <span className=\"font-mono text-[11px] text-[#859491] font-semibold\">\n                  ID: {currentCase.assessment.assessmentId}\n                </span>\n              </div>\n              <p className=\"font-sans text-xs text-[#dde4e2] leading-relaxed\">\n                {currentCase.assessment.summary}\n              </p>\n            </div>\n\n            <div className=\"mt-auto bg-[#0e1514] p-3.5 rounded border border-[#3c4948]/30 shadow-inner\">\n              <div className=\"flex justify-between items-end mb-2\">\n                <span className=\"font-mono text-[10px] font-bold text-[#859491] uppercase tracking-wider\">\n                  CONFIDENCE INTERVAL\n                </span>\n                <span className=\"font-mono text-sm font-extrabold text-[#62f9ee]\">\n                  {currentCase.assessment.confidenceInterval}%\n                </span>\n              </div>\n              <div className=\"w-full bg-[#2f3635] rounded h-1.5 overflow-hidden\">\n                <div\n                  className=\"bg-[#62f9ee] h-1.5 rounded transition-all duration-1000 shadow-[0_0_8px_#62f9ee]\"\n                  style={{ width: `${currentCase.assessment.confidenceInterval}%` }}\n                ></div>\n              </div>\n              <div className=\"flex justify-between mt-2 font-mono text-[9px] text-[#859491]\">\n                <span>LCL {currentCase.assessment.lcl}%</span>\n                <span>UCL {currentCase.assessment.ucl}%</span>\n              </div>\n            </div>\n\n            <div className=\"mt-6 pt-4 border-t border-[#3c4948]/30\">\n              <h4 className=\"font-mono text-[10px] font-bold text-[#859491] uppercase tracking-wider mb-2.5\">\n                RECOMMENDED ACTIONS\n              </h4>\n              <div className=\"flex flex-col gap-2\">\n                <button\n                  onClick={onOpenSubpoenaModal}\n                  className=\"w-full text-left px-3 py-2.5 bg-[#0e1514] hover:bg-[#242b2a] border border-[#3c4948]/50 rounded font-sans text-xs text-white transition-all flex justify-between items-center group shadow-sm hover:border-[#66FCF1]/50\"\n                >\n                  <span className=\"font-medium\">Generate Subpoena Draft</span>\n                  <span className=\"material-symbols-outlined text-[16px] text-[#859491] group-hover:text-[#66FCF1] transition-colors\">\n                    chevron_right\n                  </span>\n                </button>\n\n                <button\n                  onClick={onTriggerDeepScan}\n                  disabled={isScanning}\n                  className=\"w-full text-left px-3 py-2.5 bg-[#0e1514] hover:bg-[#242b2a] border border-[#3c4948]/50 rounded font-sans text-xs text-white transition-all flex justify-between items-center group shadow-sm hover:border-[#66FCF1]/50\"\n                >\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"font-medium\">Initiate Deep Network Scan</span>\n                    {isScanning && (\n                      <span className=\"material-symbols-outlined text-[14px] text-[#66FCF1] animate-spin\">\n                        progress_activity\n                      </span>\n                    )}\n                  </div>\n                  <span className=\"material-symbols-outlined text-[16px] text-[#859491] group-hover:text-[#66FCF1] transition-colors\">\n                    chevron_right\n                  </span>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"

    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { ForensicDossierEntity, GraphNode, GraphEdge } from \'../../types\';\n\ninterface NetworkIntelligenceViewProps {\n  dossier: ForensicDossierEntity;\n  nodes: GraphNode[];\n  edges: GraphEdge[];\n  onOpenCompleteDossier: () => void;\n}\n\nexport const NetworkIntelligenceView: React.FC<NetworkIntelligenceViewProps> = ({\n  dossier,\n  nodes,\n  edges,\n  onOpenCompleteDossier,\n}) => {\n  const [selectedNodeId, setSelectedNodeId] = useState<string>(\'P-104\');\n  const [zoomLevel, setZoomLevel] = useState<number>(1);\n  const [isDossierOpen, setIsDossierOpen] = useState<boolean>(true);\n  const [activeFilter, setActiveFilter] = useState<\'ALL\' | \'CONFIRMED\' | \'FINANCIAL\' | \'COMMS\'>(\'ALL\');\n\n  const selectedNode = nodes.find((n) => n.id === selectedNodeId) || nodes[0];\n\n  const handleZoomIn = () => setZoomLevel((prev) => Math.min(prev + 0.15, 1.8));\n  const handleZoomOut = () => setZoomLevel((prev) => Math.max(prev - 0.15, 0.6));\n  const handleResetZoom = () => setZoomLevel(1);\n\n  return (\n    <div className=\"flex-1 h-[calc(100vh-80px)] flex relative overflow-hidden bg-[#0a0d10] border border-[#3c4948]/40 rounded-lg shadow-2xl\">\n      {/* Central Interactive Graph Canvas */}\n      <section className=\"flex-1 h-full relative overflow-hidden bg-[#07090c] hud-grid\">\n        {/* Floating Canvas Controls (Top Left) */}\n        <div className=\"absolute top-4 left-4 z-30 flex flex-col gap-1 bg-[#1a2120] border border-[#3c4948]/60 rounded p-1 shadow-lg backdrop-blur-sm\">\n          <button\n            onClick={handleZoomIn}\n            className=\"w-7 h-7 flex items-center justify-center text-[#7bd6d1] hover:text-white hover:bg-[#242b2a] transition-colors rounded\"\n            title=\"Zoom In\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">add</span>\n          </button>\n          <button\n            onClick={handleZoomOut}\n            className=\"w-7 h-7 flex items-center justify-center text-[#7bd6d1] hover:text-white hover:bg-[#242b2a] transition-colors rounded\"\n            title=\"Zoom Out\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">remove</span>\n          </button>\n          <div className=\"w-5 h-px bg-[#3c4948]/50 mx-auto my-0.5\"></div>\n          <button\n            onClick={handleResetZoom}\n            className=\"w-7 h-7 flex items-center justify-center text-[#7bd6d1] hover:text-white hover:bg-[#242b2a] transition-colors rounded\"\n            title=\"Center Graph\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">my_location</span>\n          </button>\n          <button\n            onClick={() => {\n              if (activeFilter === \'ALL\') setActiveFilter(\'CONFIRMED\');\n              else if (activeFilter === \'CONFIRMED\') setActiveFilter(\'FINANCIAL\');\n              else setActiveFilter(\'ALL\');\n            }}\n            className={`w-7 h-7 flex items-center justify-center transition-colors rounded ${\n              activeFilter !== \'ALL\' ? \'text-[#66FCF1] bg-[#66FCF1]/20\' : \'text-[#7bd6d1] hover:text-white hover:bg-[#242b2a]\'\n            }`}\n            title={`Filter: ${activeFilter}`}\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">filter_alt</span>\n          </button>\n        </div>\n\n        {/* Filter Indicator Pill (Top Center) */}\n        {activeFilter !== \'ALL\' && (\n          <div className=\"absolute top-4 left-1/2 transform -translate-x-1/2 z-30 bg-[#1a2120]/90 border border-[#66FCF1]/50 px-3 py-1 rounded font-mono text-[10px] text-[#66FCF1] flex items-center gap-2 backdrop-blur-md shadow-md\">\n            <span>FILTER APPLIED: {activeFilter}</span>\n            <button\n              onClick={() => setActiveFilter(\'ALL\')}\n              className=\"text-[#859491] hover:text-white\"\n            >\n              \303\227\n            </button>\n          </div>\n        )}\n\n        {/* The Network Graph Stage */}\n        <div\n          className=\"absolute inset-0 transition-transform duration-300 origin-center flex items-center justify-center\"\n          style={{ transform: `scale(${zoomLevel})` }}\n        >\n          {/* SVG Canvas for Edges */}\n          <svg className=\"absolute inset-0 w-full h-full pointer-events-none\" style={{ zIndex: 1 }}>\n            <defs>\n              <linearGradient id=\"cyanGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n                <stop offset=\"0%\" stopColor=\"#66FCF1\" stopOpacity=\"0.8\" />\n                <stop offset=\"100%\" stopColor=\"#45A29E\" stopOpacity=\"0.4\" />\n              </linearGradient>\n            </defs>\n\n            {/* Edge: Phone -> P-104 */}\n            <line\n              x1=\"65%\"\n              y1=\"25%\"\n              x2=\"50%\"\n              y2=\"50%\"\n              stroke=\"#F6B352\"\n              strokeWidth=\"1.5\"\n              strokeDasharray=\"4\"\n              opacity=\"0.85\"\n            />\n\n            {/* Edge: Bank -> P-104 */}\n            <line\n              x1=\"28%\"\n              y1=\"75%\"\n              x2=\"50%\"\n              y2=\"50%\"\n              stroke=\"#ffb4ab\"\n              strokeWidth=\"1.5\"\n              opacity=\"0.85\"\n            />\n\n            {/* Edge: Vehicle -> P-104 */}\n            <line\n              x1=\"25%\"\n              y1=\"26%\"\n              x2=\"50%\"\n              y2=\"50%\"\n              stroke=\"#dec74a\"\n              strokeWidth=\"1.5\"\n              opacity=\"0.85\"\n            />\n\n            {/* Edge: Org -> P-104 */}\n            <line\n              x1=\"66%\"\n              y1=\"80%\"\n              x2=\"50%\"\n              y2=\"50%\"\n              stroke=\"#a1fcf7\"\n              strokeWidth=\"1.5\"\n              opacity=\"0.85\"\n            />\n\n            {/* Edge: P-104 -> U-881 */}\n            <line\n              x1=\"50%\"\n              y1=\"50%\"\n              x2=\"78%\"\n              y2=\"35%\"\n              stroke=\"#F6B352\"\n              strokeWidth=\"1.5\"\n              strokeDasharray=\"4\"\n              opacity=\"0.85\"\n            />\n          </svg>\n\n          {/* Edge Label Tags */}\n          <div className=\"absolute top-[37%] left-[58%] z-10 -translate-x-1/2 -translate-y-1/2\">\n            <span className=\"bg-[#1a2120] border border-[#F6B352]/50 px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#F6B352] rounded shadow-md\">\n              CALLED\n            </span>\n          </div>\n\n          <div className=\"absolute top-[63%] left-[38%] z-10 -translate-x-1/2 -translate-y-1/2\">\n            <span className=\"bg-[#1a2120] border border-[#ffb4ab]/50 px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#ffb4ab] rounded shadow-md\">\n              TRANSFERRED\n            </span>\n          </div>\n\n          <div className=\"absolute top-[37%] left-[37%] z-10 -translate-x-1/2 -translate-y-1/2\">\n            <span className=\"bg-[#1a2120] border border-[#dec74a]/50 px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#dec74a] rounded shadow-md\">\n              OWNED\n            </span>\n          </div>\n\n          <div className=\"absolute top-[66%] left-[59%] z-10 -translate-x-1/2 -translate-y-1/2\">\n            <span className=\"bg-[#1a2120] border border-[#a1fcf7]/50 px-1.5 py-0.5 font-mono text-[9px] font-bold text-[#a1fcf7] rounded shadow-md\">\n              ASSOCIATED\n            </span>\n          </div>\n\n          {/* NODES */}\n          {/* Center Target Node: Rahul Sharma (P-104) */}\n          <div\n            onClick={() => setSelectedNodeId(\'P-104\')}\n            className={`absolute top-[50%] left-[50%] -translate-x-1/2 -translate-y-1/2 z-20 cursor-pointer group transition-all`}\n          >\n            <div\n              className={`w-14 h-14 bg-[#1a2120] border-2 rounded flex items-center justify-center transition-all ${\n                selectedNodeId === \'P-104\'\n                  ? \'border-[#66FCF1] shadow-[0_0_20px_rgba(102,252,241,0.5)] scale-110\'\n                  : \'border-[#66FCF1]/70 hover:border-[#66FCF1]\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-[24px] text-[#66FCF1]\">person</span>\n            </div>\n            <div className=\"absolute top-full left-1/2 -translate-x-1/2 mt-1.5 bg-[#1a2120]/95 backdrop-blur-sm border border-[#3c4948]/60 px-2.5 py-1 flex flex-col items-center whitespace-nowrap rounded shadow-lg\">\n              <span className=\"font-mono text-[10px] text-[#66FCF1] font-bold uppercase tracking-wider\">\n                P-104\n              </span>\n              <span className=\"font-sans text-xs text-white font-semibold\">Rahul Sharma</span>\n            </div>\n          </div>\n\n          {/* Node: Phone (+91 98XXXXXX12) */}\n          <div\n            onClick={() => setSelectedNodeId(\'NODE-PHONE\')}\n            className=\"absolute top-[25%] left-[65%] -translate-x-1/2 -translate-y-1/2 z-20 cursor-pointer group\"\n          >\n            <div\n              className={`w-11 h-11 bg-[#1a2120] border rounded flex items-center justify-center transition-all ${\n                selectedNodeId === \'NODE-PHONE\'\n                  ? \'border-[#F6B352] shadow-[0_0_15px_rgba(246,179,82,0.5)] scale-110\'\n                  : \'border-[#F6B352]/70 hover:border-[#F6B352]\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-[20px] text-[#F6B352]\">smartphone</span>\n            </div>\n            <div className=\"absolute top-full left-1/2 -translate-x-1/2 mt-1 bg-[#1a2120]/95 backdrop-blur-sm border border-[#3c4948]/60 px-2 py-0.5 flex flex-col items-center whitespace-nowrap rounded shadow-md\">\n              <span className=\"font-mono text-[10px] text-[#F6B352] font-semibold\">\n                +91 98XXXXXX12\n              </span>\n            </div>\n          </div>\n\n          {/* Node: Bank Account (XXXX9821) */}\n          <div\n            onClick={() => setSelectedNodeId(\'NODE-BANK\')}\n            className=\"absolute top-[75%] left-[28%] -translate-x-1/2 -translate-y-1/2 z-20 cursor-pointer group\"\n          >\n            <div\n              className={`w-11 h-11 bg-[#1a2120] border rounded flex items-center justify-center transition-all ${\n                selectedNodeId === \'NODE-BANK\'\n                  ? \'border-[#ffb4ab] shadow-[0_0_15px_rgba(255,180,171,0.5)] scale-110\'\n                  : \'border-[#ffb4ab]/70 hover:border-[#ffb4ab]\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-[20px] text-[#ffb4ab]\">account_balance</span>\n            </div>\n            <div className=\"absolute top-full left-1/2 -translate-x-1/2 mt-1 bg-[#1a2120]/95 backdrop-blur-sm border border-[#3c4948]/60 px-2 py-0.5 flex flex-col items-center whitespace-nowrap rounded shadow-md\">\n              <span className=\"font-mono text-[10px] text-[#ffb4ab] font-semibold\">\n                XXXX9821\n              </span>\n            </div>\n          </div>\n\n          {/* Node: Vehicle (MH-04-AB-1234) */}\n          <div\n            onClick={() => setSelectedNodeId(\'NODE-VEHICLE\')}\n            className=\"absolute top-[26%] left-[25%] -translate-x-1/2 -translate-y-1/2 z-20 cursor-pointer group\"\n          >\n            <div\n              className={`w-11 h-11 bg-[#1a2120] border rounded flex items-center justify-center transition-all ${\n                selectedNodeId === \'NODE-VEHICLE\'\n                  ? \'border-[#dec74a] shadow-[0_0_15px_rgba(222,199,74,0.5)] scale-110\'\n                  : \'border-[#dec74a]/70 hover:border-[#dec74a]\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-[20px] text-[#dec74a]\">directions_car</span>\n            </div>\n            <div className=\"absolute top-full left-1/2 -translate-x-1/2 mt-1 bg-[#1a2120]/95 backdrop-blur-sm border border-[#3c4948]/60 px-2 py-0.5 flex flex-col items-center whitespace-nowrap rounded shadow-md\">\n              <span className=\"font-mono text-[10px] text-[#dec74a] font-semibold\">\n                MH-04-AB-1234\n              </span>\n            </div>\n          </div>\n\n          {/* Node: Organization (Aegis Holdings Ltd) */}\n          <div\n            onClick={() => setSelectedNodeId(\'NODE-ORG\')}\n            className=\"absolute top-[80%] left-[66%] -translate-x-1/2 -translate-y-1/2 z-20 cursor-pointer group\"\n          >\n            <div\n              className={`w-12 h-12 bg-[#1a2120] border rounded flex items-center justify-center transition-all ${\n                selectedNodeId === \'NODE-ORG\'\n                  ? \'border-[#a1fcf7] shadow-[0_0_15px_rgba(161,252,247,0.5)] scale-110\'\n                  : \'border-[#a1fcf7]/70 hover:border-[#a1fcf7]\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-[22px] text-[#a1fcf7]\">business</span>\n            </div>\n            <div className=\"absolute top-full left-1/2 -translate-x-1/2 mt-1 bg-[#1a2120]/95 backdrop-blur-sm border border-[#3c4948]/60 px-2.5 py-0.5 flex flex-col items-center whitespace-nowrap rounded shadow-md\">\n              <span className=\"font-sans text-xs text-white font-semibold\">\n                Aegis Holdings Ltd\n              </span>\n            </div>\n          </div>\n\n          {/* Node: U-881 */}\n          <div\n            onClick={() => setSelectedNodeId(\'U-881\')}\n            className=\"absolute top-[35%] left-[78%] -translate-x-1/2 -translate-y-1/2 z-20 cursor-pointer group\"\n          >\n            <div\n              className={`w-10 h-10 bg-[#1a2120] border rounded flex items-center justify-center transition-all ${\n                selectedNodeId === \'U-881\'\n                  ? \'border-[#F6B352] shadow-[0_0_15px_rgba(246,179,82,0.5)] scale-110\'\n                  : \'border-[#F6B352]/70 hover:border-[#F6B352]\'\n              }`}\n            >\n              <span className=\"material-symbols-outlined text-[18px] text-[#F6B352]\">person</span>\n            </div>\n            <div className=\"absolute top-full left-1/2 -translate-x-1/2 mt-1 bg-[#1a2120]/95 backdrop-blur-sm border border-[#3c4948]/60 px-2 py-0.5 flex flex-col items-center whitespace-nowrap rounded shadow-md\">\n              <span className=\"font-mono text-[10px] text-[#F6B352] font-semibold\">U-881</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Graph Legend / Stats overlay (Bottom Left) */}\n        <div className=\"absolute bottom-4 left-4 bg-[#1a2120]/95 border border-[#3c4948]/50 p-2.5 flex items-center gap-4 rounded shadow-lg backdrop-blur-sm z-30\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-4 h-0.5 bg-[#66FCF1]\"></span>\n            <span className=\"font-mono text-[10px] text-[#bacac7]\">Confirmed</span>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-4 h-0.5 border-t border-dashed border-[#F6B352]\"></span>\n            <span className=\"font-mono text-[10px] text-[#bacac7]\">Suspected</span>\n          </div>\n          <div className=\"w-px h-3.5 bg-[#3c4948]/60 mx-1\"></div>\n          <span className=\"font-mono text-[10px] font-bold text-[#7bd6d1]\">N: 142</span>\n          <span className=\"font-mono text-[10px] font-bold text-[#7bd6d1]\">E: 318</span>\n        </div>\n\n        {/* Dossier Toggle Trigger if Closed */}\n        {!isDossierOpen && (\n          <button\n            onClick={() => setIsDossierOpen(true)}\n            className=\"absolute top-4 right-4 z-30 bg-[#1a2120] border border-[#66FCF1]/60 text-[#66FCF1] px-3 py-1.5 rounded font-mono text-[10px] font-bold uppercase tracking-wider flex items-center gap-1.5 shadow-lg hover:bg-[#66FCF1] hover:text-[#00201e] transition-all\"\n          >\n            <span className=\"material-symbols-outlined text-[16px]\">description</span>\n            OPEN DOSSIER\n          </button>\n        )}\n      </section>\n\n      {/* Right Panel: FORENSIC DOSSIER (340px) */}\n      {isDossierOpen && (\n        <aside className=\"w-[340px] h-full bg-[#161b21] flex flex-col flex-shrink-0 z-20 border-l border-[#3c4948]/40 shadow-2xl overflow-y-auto\">\n          {/* Dossier Header */}\n          <div className=\"p-4 border-b border-[#3c4948]/40 bg-[#1a2027]\">\n            <div className=\"flex justify-between items-start mb-3\">\n              <h2 className=\"font-mono text-xs font-bold text-[#7bd6d1] flex items-center gap-2 tracking-wider uppercase\">\n                <span className=\"material-symbols-outlined text-[16px]\">description</span> FORENSIC DOSSIER\n              </h2>\n              <button\n                onClick={() => setIsDossierOpen(false)}\n                className=\"text-[#859491] hover:text-white transition-colors\"\n                title=\"Collapse Dossier\"\n              >\n                <span className=\"material-symbols-outlined text-[18px]\">close</span>\n              </button>\n            </div>\n\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-11 h-11 bg-[#090f0f] border-2 border-[#66FCF1] flex items-center justify-center flex-shrink-0 rounded shadow-md\">\n                <span className=\"material-symbols-outlined text-[22px] text-[#66FCF1]\">person</span>\n              </div>\n              <div>\n                <div className=\"font-mono text-[9px] text-[#66FCF1] font-bold mb-0.5 uppercase tracking-wider\">\n                  Target Entity\n                </div>\n                <h3 className=\"font-sans text-sm font-bold text-white leading-tight\">\n                  {selectedNodeId === \'P-104\' ? dossier.name : selectedNode.label}\n                </h3>\n                <div className=\"font-mono text-[10px] text-[#859491]\">ID: {selectedNode.id}</div>\n              </div>\n            </div>\n          </div>\n\n          {/* Dossier Content */}\n          <div className=\"flex-1 p-4 space-y-5 overflow-y-auto\">\n            {/* Network Metrics Table */}\n            <div>\n              <h4 className=\"font-mono text-[9px] font-bold text-[#7bd6d1] uppercase tracking-widest mb-2 border-b border-[#3c4948]/40 pb-1\">\n                Network Metrics\n              </h4>\n              <div className=\"grid grid-cols-2 text-center font-mono text-xs border border-[#3c4948]/40 bg-[#090f0f]/60 rounded overflow-hidden\">\n                <div className=\"p-2 border-r border-b border-[#3c4948]/40\">\n                  <div className=\"text-[9px] text-[#859491] uppercase mb-0.5\">DEGREE</div>\n                  <div className=\"text-white font-bold\">{dossier.degree}</div>\n                </div>\n                <div className=\"p-2 border-b border-[#3c4948]/40\">\n                  <div className=\"text-[9px] text-[#859491] uppercase mb-0.5\">BETWEENNESS</div>\n                  <div className=\"text-[#66FCF1] font-bold\">{dossier.betweenness}</div>\n                </div>\n                <div className=\"p-2 border-r border-b border-[#3c4948]/40\">\n                  <div className=\"text-[9px] text-[#859491] uppercase mb-0.5\">CASES</div>\n                  <div className=\"text-white font-bold\">{dossier.cases}</div>\n                </div>\n                <div className=\"p-2 border-b border-[#3c4948]/40\">\n                  <div className=\"text-[9px] text-[#859491] uppercase mb-0.5\">COMM LINKS</div>\n                  <div className=\"text-white font-bold\">{dossier.commLinks}</div>\n                </div>\n                <div className=\"p-2 col-span-2\">\n                  <div className=\"text-[9px] text-[#859491] uppercase mb-0.5\">FINANCIAL TIES</div>\n                  <div className=\"text-white font-bold\">{dossier.financialTies}</div>\n                </div>\n              </div>\n            </div>\n\n            {/* Flag Criteria Met */}\n            <div>\n              <h4 className=\"font-mono text-[9px] font-bold text-[#F6B352] uppercase tracking-widest flex items-center gap-1.5 mb-2 border-b border-[#F6B352]/30 pb-1\">\n                <span className=\"material-symbols-outlined text-[14px]\">flag</span> Flag Criteria Met\n              </h4>\n              <div className=\"bg-[#090f0f]/80 border border-[#3c4948]/40 p-3 rounded space-y-2\">\n                {dossier.flagCriteria.map((flag, idx) => (\n                  <div key={idx} className=\"flex items-start gap-2\">\n                    <span className=\"material-symbols-outlined text-[14px] text-[#F6B352] mt-0.5 flex-shrink-0\">\n                      adjust\n                    </span>\n                    <span className=\"font-sans text-[11px] text-[#bacac7] leading-relaxed\">\n                      {flag}\n                    </span>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Investigative Tactical Assessment (AI) */}\n            <div className=\"relative bg-[#090f0f] border border-[#66FCF1]/40 p-3.5 rounded shadow-[inset_0_0_12px_rgba(102,252,241,0.08)]\">\n              <div className=\"absolute top-0 right-0 px-2 py-0.5 bg-[#66FCF1]/10 border-b border-l border-[#66FCF1]/30 text-[#66FCF1] font-mono text-[8px] font-bold uppercase tracking-wider\">\n                AI Lead Analysis\n              </div>\n              <h4 className=\"font-mono text-[9px] font-bold text-[#66FCF1] uppercase tracking-widest flex items-center gap-1.5 mb-2\">\n                <span className=\"material-symbols-outlined text-[14px]\">psychology</span> Tactical Assessment\n              </h4>\n              <p className=\"font-sans text-[11px] text-[#dde4e2] leading-relaxed\">\n                {dossier.tacticalAssessment}\n              </p>\n            </div>\n          </div>\n\n          {/* Footer & Complete Dossier Action */}\n          <div className=\"p-4 border-t border-[#3c4948]/40 bg-[#1a2027] mt-auto\">\n            <p className=\"font-mono text-[8px] text-[#859491] leading-tight uppercase tracking-wider mb-3\">\n              Notice: AI-generated findings are investigative leads and require human verification before operational deployment. Refer to directive 4.B for compliance.\n            </p>\n            <button\n              onClick={onOpenCompleteDossier}\n              className=\"w-full py-2.5 font-mono text-[10px] font-bold uppercase tracking-widest border border-[#66FCF1] text-[#66FCF1] hover:bg-[#66FCF1] hover:text-[#00201e] transition-all rounded shadow-md\"\n            >\n              View Complete Dossier\n            </button>\n          </div>\n        </aside>\n      )}\n    </div>\n  );\n};\n"
    }

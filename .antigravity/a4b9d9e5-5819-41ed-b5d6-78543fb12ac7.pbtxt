    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { InvestigationCase, ActiveView } from \'../../types\';\n\ninterface CommandCenterViewProps {\n  cases: InvestigationCase[];\n  onSelectCase: (caseItem: InvestigationCase) => void;\n  onNavigate: (view: ActiveView) => void;\n}\n\nexport const CommandCenterView: React.FC<CommandCenterViewProps> = ({\n  cases,\n  onSelectCase,\n  onNavigate,\n}) => {\n  return (\n    <div className=\"flex-1 flex flex-col gap-6 overflow-y-auto pr-2 pb-10\">\n      {/* View Header */}\n      <div>\n        <h2 className=\"font-sans text-3xl font-bold text-white tracking-tight\">\n          Investigation Command Center\n        </h2>\n        <p className=\"font-sans text-sm text-[#bacac7] mt-1\">\n          Cross-source intelligence overview\n        </p>\n      </div>\n\n      {/* Metrics Bar */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* Metric 1 */}\n        <div className=\"bg-[#1a2120] border border-[#3c4948]/40 p-3.5 rounded flex flex-col gap-1 shadow-sm\">\n          <span className=\"font-mono text-[10px] font-bold tracking-widest text-[#bacac7] uppercase\">\n            ACTIVE CASES\n          </span>\n          <span className=\"font-mono text-2xl font-bold text-white tracking-tight\">24</span>\n        </div>\n\n        {/* Metric 2 */}\n        <div className=\"bg-[#1a2120] border border-[#3c4948]/40 p-3.5 rounded flex flex-col gap-1 shadow-sm\">\n          <span className=\"font-mono text-[10px] font-bold tracking-widest text-[#bacac7] uppercase\">\n            ENTITIES UNDER ANALYSIS\n          </span>\n          <span className=\"font-mono text-2xl font-bold text-white tracking-tight\">1,284</span>\n        </div>\n\n        {/* Metric 3 */}\n        <div className=\"bg-[#1a2120] border border-[#3c4948]/40 p-3.5 rounded flex flex-col gap-1 shadow-sm\">\n          <span className=\"font-mono text-[10px] font-bold tracking-widest text-[#bacac7] uppercase\">\n            CROSS-CASE LINKS\n          </span>\n          <span className=\"font-mono text-2xl font-bold text-white tracking-tight\">67</span>\n        </div>\n\n        {/* Metric 4 */}\n        <div className=\"bg-[#1a2120] border border-[#3c4948]/40 border-l-[3px] border-l-[#ffb4ab] p-3.5 rounded flex flex-col gap-1 shadow-sm\">\n          <span className=\"font-mono text-[10px] font-bold tracking-widest text-[#ffb4ab] uppercase\">\n            HIGH PRIORITY LEADS\n          </span>\n          <span className=\"font-mono text-2xl font-bold text-white tracking-tight\">12</span>\n        </div>\n      </div>\n\n      {/* Middle Section: Network Activity & Priority Panel */}\n      <div className=\"flex flex-col lg:flex-row gap-4 min-h-[420px]\">\n        {/* Network Activity Visualization */}\n        <div className=\"flex-[3] bg-[#1a2120] border border-[#3c4948]/40 rounded relative overflow-hidden flex flex-col shadow-sm\">\n          <div className=\"px-4 py-2.5 border-b border-[#3c4948]/40 flex justify-between items-center bg-[#242b2a]/60\">\n            <span className=\"font-mono text-[10px] font-bold tracking-widest text-[#bacac7] uppercase\">\n              NETWORK ACTIVITY\n            </span>\n            <button\n              onClick={() => onNavigate(\'network\')}\n              className=\"font-mono text-[11px] text-[#7bd6d1] hover:text-[#66FCF1] flex items-center gap-1.5 transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-[14px] animate-pulse\">my_location</span>\n              <span>LIVE TRACE</span>\n            </button>\n          </div>\n\n          <div className=\"flex-1 relative bg-[#090f0f] min-h-[340px] hud-grid cursor-pointer\" onClick={() => onNavigate(\'network\')}>\n            {/* SVG Connecting Lines */}\n            <svg className=\"absolute inset-0 w-full h-full pointer-events-none\" style={{ zIndex: 1 }}>\n              {/* Phone to P-104 */}\n              <line\n                x1=\"26%\"\n                y1=\"25%\"\n                x2=\"48%\"\n                y2=\"48%\"\n                stroke=\"#859491\"\n                strokeWidth=\"1.5\"\n                strokeDasharray=\"4\"\n              />\n              <text\n                x=\"34%\"\n                y=\"33%\"\n                fill=\"#bacac7\"\n                fontFamily=\"JetBrains Mono\"\n                fontSize=\"9\"\n                fontWeight=\"700\"\n                letterSpacing=\"0.1em\"\n                transform=\"rotate(32, 280, 110)\"\n              >\n                CALLED\n              </text>\n\n              {/* Bank to P-104 */}\n              <line\n                x1=\"22%\"\n                y1=\"64%\"\n                x2=\"46%\"\n                y2=\"52%\"\n                stroke=\"#859491\"\n                strokeWidth=\"1.5\"\n              />\n              <text\n                x=\"31%\"\n                y=\"61%\"\n                fill=\"#bacac7\"\n                fontFamily=\"JetBrains Mono\"\n                fontSize=\"9\"\n                fontWeight=\"700\"\n                letterSpacing=\"0.1em\"\n                transform=\"rotate(-15, 230, 210)\"\n              >\n                TRANSFERRED\n              </text>\n\n              {/* Car to P-104 */}\n              <line\n                x1=\"50%\"\n                y1=\"72%\"\n                x2=\"50%\"\n                y2=\"56%\"\n                stroke=\"#859491\"\n                strokeWidth=\"1.5\"\n              />\n              <text\n                x=\"51%\"\n                y=\"67%\"\n                fill=\"#bacac7\"\n                fontFamily=\"JetBrains Mono\"\n                fontSize=\"9\"\n                fontWeight=\"700\"\n                letterSpacing=\"0.1em\"\n              >\n                OWNED\n              </text>\n\n              {/* P-104 to U-881 (Suspected) */}\n              <line\n                x1=\"55%\"\n                y1=\"48%\"\n                x2=\"72%\"\n                y2=\"33%\"\n                stroke=\"#F6B352\"\n                strokeWidth=\"1.5\"\n                strokeDasharray=\"4\"\n              />\n              <text\n                x=\"62%\"\n                y=\"41%\"\n                fill=\"#F6B352\"\n                fontFamily=\"JetBrains Mono\"\n                fontSize=\"9\"\n                fontWeight=\"700\"\n                letterSpacing=\"0.1em\"\n                transform=\"rotate(-30, 480, 140)\"\n              >\n                ASSOCIATED\n              </text>\n            </svg>\n\n            {/* Nodes */}\n            {/* Node: Phone */}\n            <div className=\"absolute top-[18%] left-[16%] px-3 py-2 rounded bg-[#2f3635] border border-[#3c4948]/70 flex items-center gap-2 shadow-md z-10 hover:border-[#F6B352] transition-colors\">\n              <span className=\"material-symbols-outlined text-[#F6B352] text-[16px]\">phone_iphone</span>\n              <span className=\"font-mono text-[11px] text-[#dde4e2] font-semibold\">+91 98XXXXXX12</span>\n            </div>\n\n            {/* Node: Bank */}\n            <div className=\"absolute top-[60%] left-[12%] px-3 py-2 rounded bg-[#2f3635] border border-[#3c4948]/70 flex items-center gap-2 shadow-md z-10 hover:border-[#ffb4ab] transition-colors\">\n              <span className=\"material-symbols-outlined text-[#ffb4ab] text-[16px]\">account_balance</span>\n              <span className=\"font-mono text-[11px] text-[#dde4e2] font-semibold\">Account XXXX9821</span>\n            </div>\n\n            {/* Node: Car */}\n            <div className=\"absolute top-[72%] left-[43%] px-3 py-2 rounded bg-[#2f3635] border border-[#3c4948]/70 flex items-center gap-2 shadow-md z-10 hover:border-[#dec74a] transition-colors\">\n              <span className=\"material-symbols-outlined text-[#dec74a] text-[16px]\">directions_car</span>\n              <span className=\"font-mono text-[11px] text-[#dde4e2] font-semibold\">MH-04-AB-1234</span>\n            </div>\n\n            {/* Node: U-881 */}\n            <div className=\"absolute top-[28%] left-[70%] px-3 py-2 rounded bg-[#2f3635] border border-[#3c4948]/70 flex items-center gap-2 shadow-md z-10 hover:border-[#F6B352] transition-colors\">\n              <span className=\"material-symbols-outlined text-[#F6B352] text-[16px]\">person</span>\n              <span className=\"font-mono text-[11px] text-[#dde4e2] font-semibold\">U-881</span>\n            </div>\n\n            {/* Central Bridge Entity P-104 */}\n            <div className=\"absolute top-[42%] left-[38%] px-4 py-3 rounded bg-[#2f3635] border-2 border-[#66FCF1] flex flex-col items-center gap-1 shadow-[0_0_15px_rgba(102,252,241,0.25)] z-20\">\n              <span className=\"material-symbols-outlined text-[#66FCF1] text-[20px]\">person_search</span>\n              <span className=\"font-mono text-[12px] font-bold text-white\">P-104 (Rahul Sharma)</span>\n              <span className=\"font-mono text-[9px] text-[#66FCF1] tracking-widest uppercase\">BRIDGE NODE</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Priority Intelligence Panel */}\n        <div className=\"flex-1 bg-[#1a2120] border border-[#3c4948]/40 rounded p-4 flex flex-col gap-4 border-t-[3px] border-t-[#66FCF1] shadow-sm\">\n          <div>\n            <span className=\"font-mono text-[10px] font-bold tracking-widest text-[#7bd6d1] mb-1 block uppercase\">\n              PRIORITY INTELLIGENCE\n            </span>\n            <h3 className=\"font-sans text-lg font-bold text-white\">Target: P-104</h3>\n            <p className=\"font-mono text-[12px] text-[#bacac7] mt-0.5\">Rahul Sharma</p>\n          </div>\n\n          <div className=\"flex flex-col gap-3 border-y border-[#3c4948]/40 py-4 my-1\">\n            <div className=\"flex justify-between items-center\">\n              <span className=\"font-sans text-xs text-[#bacac7]\">Confidence Score</span>\n              <span className=\"font-mono text-[11px] text-[#00201e] bg-[#66FCF1] px-2 py-0.5 rounded font-extrabold shadow-sm\">\n                91%\n              </span>\n            </div>\n            <div className=\"flex justify-between items-center\">\n              <span className=\"font-sans text-xs text-[#bacac7]\">Connected Entities</span>\n              <span className=\"font-mono text-[12px] text-white font-bold\">17</span>\n            </div>\n            <div className=\"flex justify-between items-center\">\n              <span className=\"font-sans text-xs text-[#bacac7]\">Active Cases</span>\n              <span className=\"font-mono text-[12px] text-white font-bold\">6</span>\n            </div>\n          </div>\n\n          <div className=\"mt-auto\">\n            <button\n              onClick={() => {\n                const targetCase = cases.find((c) => c.id === \'CN-2026-0142\') || cases[0];\n                onSelectCase(targetCase);\n                onNavigate(\'investigations\');\n              }}\n              className=\"w-full bg-[#2f3635] border border-[#3c4948]/60 text-white font-mono text-[10px] py-2.5 rounded hover:bg-[#66FCF1] hover:text-[#00201e] hover:border-[#66FCF1] transition-all font-bold tracking-widest flex items-center justify-center gap-2 shadow-sm\"\n            >\n              OPEN INVESTIGATION\n              <span className=\"material-symbols-outlined text-[16px]\">open_in_new</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom Section: Active Investigations */}\n      <div className=\"bg-[#1a2120] border border-[#3c4948]/40 rounded flex flex-col shadow-sm overflow-hidden\">\n        <div className=\"px-4 py-3 border-b border-[#3c4948]/40 bg-[#242b2a]/60 flex items-center justify-between\">\n          <span className=\"font-mono text-[10px] font-bold tracking-widest text-[#bacac7] uppercase\">\n            ACTIVE INVESTIGATIONS\n          </span>\n          <span className=\"font-mono text-[10px] text-[#7bd6d1]\">{cases.length} REGISTERED FILES</span>\n        </div>\n\n        <div className=\"flex flex-col\">\n          {/* Table Header */}\n          <div className=\"grid grid-cols-[1fr_2fr_1fr_1fr] px-4 py-2 bg-[#090f0f] font-mono text-[10px] font-bold tracking-wider text-[#859491] border-b border-[#3c4948]/40\">\n            <div>CASE ID</div>\n            <div>DESCRIPTION</div>\n            <div>PRIORITY</div>\n            <div className=\"text-right\">LAST UPDATED</div>\n          </div>\n\n          {/* Rows */}\n          {cases.map((caseItem) => (\n            <div\n              key={caseItem.id}\n              onClick={() => {\n                onSelectCase(caseItem);\n                onNavigate(\'investigations\');\n              }}\n              className=\"grid grid-cols-[1fr_2fr_1fr_1fr] px-4 py-3.5 items-center hover:bg-[#242b2a] border-b border-[#3c4948]/20 transition-colors group cursor-pointer\"\n            >\n              <div className=\"font-mono text-[12px] text-white font-semibold group-hover:text-[#66FCF1] transition-colors flex items-center gap-1.5\">\n                <span className=\"material-symbols-outlined text-[14px] text-[#7bd6d1] opacity-0 group-hover:opacity-100 transition-opacity\">\n                  arrow_right\n                </span>\n                {caseItem.id}\n              </div>\n              <div className=\"font-sans text-xs text-[#dde4e2] font-medium\">\n                {caseItem.title}\n              </div>\n              <div>\n                <span\n                  className={`px-2 py-0.5 rounded font-mono text-[10px] font-extrabold tracking-wider ${\n                    caseItem.priority === \'HIGH\'\n                      ? \'bg-[#93000a] text-[#ffdad6] border border-[#ffb4ab]/30\'\n                      : caseItem.priority === \'MEDIUM\'\n                      ? \'bg-[#736400] text-[#fce363] border border-[#fce363]/30\'\n                      : \'bg-[#007774]/40 text-[#a1fcf7] border border-[#a1fcf7]/30\'\n                  }`}\n                >\n                  {caseItem.priority}\n                </span>\n              </div>\n              <div className=\"font-mono text-[11px] text-[#bacac7] text-right\">\n                {caseItem.lastUpdated}\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }

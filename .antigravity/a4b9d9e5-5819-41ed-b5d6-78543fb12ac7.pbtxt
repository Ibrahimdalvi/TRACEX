    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Sidebar } from \'./components/layout/Sidebar\';\nimport { Header } from \'./components/layout/Header\';\nimport { CommandCenterView } from \'./components/views/CommandCenterView\';\nimport { CaseInvestigationView } from \'./components/views/CaseInvestigationView\';\nimport { AlertsCopilotView } from \'./components/views/AlertsCopilotView\';\nimport { NetworkIntelligenceView } from \'./components/views/NetworkIntelligenceView\';\nimport { EvidenceVaultView } from \'./components/views/EvidenceVaultView\';\nimport { EntitiesRegistryView } from \'./components/views/EntitiesRegistryView\';\nimport { TimelineView } from \'./components/views/TimelineView\';\nimport { ReportsView } from \'./components/views/ReportsView\';\n\nimport { SubpoenaDraftModal } from \'./components/modals/SubpoenaDraftModal\';\nimport { ExportDossierModal } from \'./components/modals/ExportDossierModal\';\nimport { CaseSelectorModal } from \'./components/modals/CaseSelectorModal\';\nimport { DeepScanProgressModal } from \'./components/modals/DeepScanProgressModal\';\nimport { SystemStatusModal } from \'./components/modals/SystemStatusModal\';\n\nimport {\n  INITIAL_CASES,\n  PRIMARY_TARGET_DOSSIER,\n  INITIAL_ALERTS,\n  NETWORK_GRAPH_NODES,\n  NETWORK_GRAPH_EDGES,\n  MOCK_EVIDENCE,\n  MOCK_TIMELINE,\n} from \'./data/mockData\';\nimport {\n  ActiveView,\n  InvestigationCase,\n  IntelAlert,\n  ForensicDossierEntity,\n  EvidenceRecord,\n} from \'./types\';\n\nexport function App() {\n  const [activeView, setActiveView] = useState<ActiveView>(\'command-center\');\n  const [cases, setCases] = useState<InvestigationCase[]>(INITIAL_CASES);\n  const [currentCase, setCurrentCase] = useState<InvestigationCase>(INITIAL_CASES[0]);\n  const [alerts, setAlerts] = useState<IntelAlert[]>(INITIAL_ALERTS);\n  const [dossier] = useState<ForensicDossierEntity>(PRIMARY_TARGET_DOSSIER);\n  const [evidenceList] = useState<EvidenceRecord[]>(MOCK_EVIDENCE);\n  const [timeline] = useState(MOCK_TIMELINE);\n\n  // Modals state\n  const [isSubpoenaOpen, setIsSubpoenaOpen] = useState(false);\n  const [isExportOpen, setIsExportOpen] = useState(false);\n  const [isCaseSelectorOpen, setIsCaseSelectorOpen] = useState(false);\n  const [isDeepScanOpen, setIsDeepScanOpen] = useState(false);\n  const [isScanning, setIsScanning] = useState(false);\n  const [deepScanResult, setDeepScanResult] = useState<any>(null);\n  const [isSystemStatusOpen, setIsSystemStatusOpen] = useState(false);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  // Handle case selection\n  const handleSelectCase = (selectedCase: InvestigationCase) => {\n    setCurrentCase(selectedCase);\n  };\n\n  // Acknowledge alerts\n  const handleAcknowledgeAllAlerts = () => {\n    setAlerts((prev) => prev.map((a) => ({ ...a, acknowledged: true })));\n  };\n\n  // Trigger Deep Scan via Backend API\n  const handleTriggerDeepScan = async () => {\n    setIsDeepScanOpen(true);\n    setIsScanning(true);\n    try {\n      const response = await fetch(\'/api/intelligence/deep-scan\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ caseId: currentCase.id }),\n      });\n      const data = await response.json();\n      setDeepScanResult(data);\n    } catch (err) {\n      setDeepScanResult({\n        scanId: \'SCAN-2026-X8\',\n        nodesAnalyzed: 142,\n        edgesScanned: 318,\n        anomaliesDetected: 4,\n        newBridgeCandidates: [\'P-104 (Rahul Sharma)\', \'ORG-42 (Aegis Holdings FZE)\'],\n        riskLevel: \'CRITICAL\',\n        summary:\n          \'Deep network recursive scan discovered 4 cyclic wire patterns traversing Dubai and Caribbean intermediary accounts.\',\n      });\n    } finally {\n      setIsScanning(false);\n    }\n  };\n\n  const unreadAlertsCount = alerts.filter((a) => !a.acknowledged).length;\n\n  return (\n    <div className=\"flex h-screen w-screen bg-[#0B0C10] text-[#dde4e2] overflow-hidden select-none font-sans\">\n      {/* HUD Navigation Sidebar */}\n      <Sidebar\n        activeView={activeView}\n        onSelectView={(view) => setActiveView(view)}\n        onOpenSystemStatus={() => setIsSystemStatusOpen(true)}\n        unreadAlertsCount={unreadAlertsCount}\n      />\n\n      {/* Main Content Area */}\n      <div className=\"flex-1 ml-72 flex flex-col h-screen overflow-hidden\">\n        {/* Top Header */}\n        <Header\n          currentCase={currentCase}\n          onOpenCaseSelector={() => setIsCaseSelectorOpen(true)}\n          onOpenAlerts={() => setActiveView(\'alerts\')}\n          onOpenSettings={() => setIsSystemStatusOpen(true)}\n          searchQuery={searchQuery}\n          onSearchChange={setSearchQuery}\n          showSearch={activeView === \'network\' || activeView === \'entities\'}\n        />\n\n        {/* View Router with Padding */}\n        <main className=\"flex-1 mt-16 p-6 overflow-hidden flex flex-col\">\n          {activeView === \'command-center\' && (\n            <CommandCenterView\n              cases={cases}\n              onSelectCase={(caseItem) => {\n                handleSelectCase(caseItem);\n                setActiveView(\'investigations\');\n              }}\n              onNavigate={(view) => setActiveView(view)}\n            />\n          )}\n\n          {activeView === \'investigations\' && (\n            <CaseInvestigationView\n              currentCase={currentCase}\n              onNavigate={(view) => setActiveView(view)}\n              onOpenExportDossier={() => setIsExportOpen(true)}\n              onOpenSubpoenaModal={() => setIsSubpoenaOpen(true)}\n              onTriggerDeepScan={handleTriggerDeepScan}\n              isScanning={isScanning}\n            />\n          )}\n\n          {activeView === \'network\' && (\n            <NetworkIntelligenceView\n              dossier={dossier}\n              nodes={NETWORK_GRAPH_NODES}\n              edges={NETWORK_GRAPH_EDGES}\n              onOpenCompleteDossier={() => setIsExportOpen(true)}\n            />\n          )}\n\n          {activeView === \'alerts\' && (\n            <AlertsCopilotView\n              alerts={alerts}\n              currentCase={currentCase}\n              onAcknowledgeAll={handleAcknowledgeAllAlerts}\n              onSelectAlert={(alert) => {\n                if (alert.targetCase) {\n                  const matched = cases.find((c) => c.id === alert.targetCase);\n                  if (matched) setCurrentCase(matched);\n                }\n              }}\n              onNavigate={(view) => setActiveView(view)}\n            />\n          )}\n\n          {activeView === \'evidence\' && (\n            <EvidenceVaultView\n              evidenceList={evidenceList}\n              currentCase={currentCase}\n              onSelectEvidence={() => setIsExportOpen(true)}\n            />\n          )}\n\n          {activeView === \'entities\' && (\n            <EntitiesRegistryView\n              onSelectEntity={() => {\n                setActiveView(\'network\');\n              }}\n              onNavigate={(view) => setActiveView(view)}\n            />\n          )}\n\n          {activeView === \'timeline\' && (\n            <TimelineView timeline={timeline} currentCase={currentCase} />\n          )}\n\n          {activeView === \'reports\' && (\n            <ReportsView\n              currentCase={currentCase}\n              onOpenExportDossier={() => setIsExportOpen(true)}\n            />\n          )}\n\n          {activeView === \'intelligence\' && (\n            <NetworkIntelligenceView\n              dossier={dossier}\n              nodes={NETWORK_GRAPH_NODES}\n              edges={NETWORK_GRAPH_EDGES}\n              onOpenCompleteDossier={() => setIsExportOpen(true)}\n            />\n          )}\n        </main>\n      </div>\n\n      {/* Global Modals */}\n      <SubpoenaDraftModal\n        isOpen={isSubpoenaOpen}\n        onClose={() => setIsSubpoenaOpen(false)}\n        currentCase={currentCase}\n      />\n\n      <ExportDossierModal\n        isOpen={isExportOpen}\n        onClose={() => setIsExportOpen(false)}\n        currentCase={currentCase}\n      />\n\n      <CaseSelectorModal\n        isOpen={isCaseSelectorOpen}\n        onClose={() => setIsCaseSelectorOpen(false)}\n        cases={cases}\n        currentCaseId={currentCase.id}\n        onSelectCase={handleSelectCase}\n      />\n\n      <DeepScanProgressModal\n        isOpen={isDeepScanOpen}\n        onClose={() => setIsDeepScanOpen(false)}\n        scanData={deepScanResult}\n        isScanning={isScanning}\n      />\n\n      <SystemStatusModal\n        isOpen={isSystemStatusOpen}\n        onClose={() => setIsSystemStatusOpen(false)}\n      />\n    </div>\n  );\n}\n\nexport default App;\n"
    }

    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\n\ninterface DeepScanProgressModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  scanData: any;\n  isScanning: boolean;\n}\n\nexport const DeepScanProgressModal: React.FC<DeepScanProgressModalProps> = ({\n  isOpen,\n  onClose,\n  scanData,\n  isScanning,\n}) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md animate-fadeIn\">\n      <div className=\"bg-[#161b21] border border-[#3c4948]/70 w-full max-w-xl rounded-lg shadow-2xl overflow-hidden flex flex-col\">\n        <div className=\"p-4 bg-[#1a2027] border-b border-[#3c4948]/40 flex justify-between items-center\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-[#66FCF1] text-[20px] animate-pulse\">\n              radar\n            </span>\n            <h3 className=\"font-mono text-sm font-bold text-white uppercase tracking-wider\">\n              DEEP TOPOLOGICAL NETWORK SCAN\n            </h3>\n          </div>\n          {!isScanning && (\n            <button onClick={onClose} className=\"text-[#859491] hover:text-white\">\n              <span className=\"material-symbols-outlined text-[20px]\">close</span>\n            </button>\n          )}\n        </div>\n\n        <div className=\"p-5 space-y-4\">\n          {isScanning ? (\n            <div className=\"py-8 flex flex-col items-center justify-center text-center space-y-4\">\n              <div className=\"relative w-24 h-24\">\n                <div className=\"absolute inset-0 rounded-full border-2 border-[#66FCF1]/20 animate-ping\"></div>\n                <div className=\"absolute inset-0 rounded-full border-2 border-[#66FCF1] animate-spin-slow\"></div>\n                <div className=\"absolute inset-0 flex items-center justify-center\">\n                  <span className=\"material-symbols-outlined text-[#66FCF1] text-[36px]\">\n                    hub\n                  </span>\n                </div>\n              </div>\n              <div>\n                <h4 className=\"font-mono text-sm font-bold text-white uppercase tracking-wider\">\n                  TRAVERSING RECURSIVE ADJACENCY MATRIX...\n                </h4>\n                <p className=\"font-mono text-xs text-[#7bd6d1] mt-1\">\n                  Correlating 142 nodes, 318 edges across 24 historical case graphs\n                </p>\n              </div>\n            </div>\n          ) : (\n            <div className=\"space-y-4 font-sans text-xs\">\n              <div className=\"p-3 bg-[#0e1514] border border-[#ffb4ab]/40 rounded border-l-4 border-l-[#ffb4ab]\">\n                <div className=\"flex justify-between items-center mb-1\">\n                  <span className=\"font-mono text-[10px] font-bold text-[#ffb4ab] uppercase\">\n                    SCAN RESULT: {scanData?.riskLevel || \'CRITICAL\'}\n                  </span>\n                  <span className=\"font-mono text-[10px] text-[#859491]\">\n                    ID: {scanData?.scanId || \'SCAN-09\'}\n                  </span>\n                </div>\n                <p className=\"text-[#dde4e2] leading-relaxed\">\n                  {scanData?.summary || \'Deep network recursive scan discovered 4 cyclic wire patterns traversing Dubai and Caribbean intermediary accounts.\'}\n                </p>\n              </div>\n\n              <div className=\"grid grid-cols-3 gap-2 font-mono text-center\">\n                <div className=\"p-2.5 bg-[#0e1514] border border-[#3c4948]/40 rounded\">\n                  <div className=\"text-[9px] text-[#859491] uppercase\">NODES ANALYZED</div>\n                  <div className=\"text-white font-bold text-base mt-0.5\">\n                    {scanData?.nodesAnalyzed || 142}\n                  </div>\n                </div>\n                <div className=\"p-2.5 bg-[#0e1514] border border-[#3c4948]/40 rounded\">\n                  <div className=\"text-[9px] text-[#859491] uppercase\">EDGES SCANNED</div>\n                  <div className=\"text-white font-bold text-base mt-0.5\">\n                    {scanData?.edgesScanned || 318}\n                  </div>\n                </div>\n                <div className=\"p-2.5 bg-[#0e1514] border border-[#3c4948]/40 rounded\">\n                  <div className=\"text-[9px] text-[#859491] uppercase\">ANOMALIES</div>\n                  <div className=\"text-[#ffb4ab] font-bold text-base mt-0.5\">\n                    {scanData?.anomaliesDetected || 4}\n                  </div>\n                </div>\n              </div>\n\n              <div>\n                <span className=\"font-mono text-[10px] font-bold text-[#7bd6d1] uppercase tracking-wider block mb-1\">\n                  PRIMARY BRIDGE CONDUITS IDENTIFIED\n                </span>\n                <div className=\"flex flex-wrap gap-2\">\n                  {(scanData?.newBridgeCandidates || [\'P-104 (Rahul Sharma)\', \'ORG-42 (Aegis Holdings FZE)\']).map((c: string, idx: number) => (\n                    <span\n                      key={idx}\n                      className=\"px-2.5 py-1 rounded bg-[#0e1514] border border-[#66FCF1]/50 text-[#66FCF1] font-mono text-xs font-bold\"\n                    >\n                      {c}\n                    </span>\n                  ))}\n                </div>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {!isScanning && (\n          <div className=\"p-4 bg-[#1a2027] border-t border-[#3c4948]/40 flex justify-end\">\n            <button\n              onClick={onClose}\n              className=\"px-4 py-2 bg-[#66FCF1] text-[#00201e] font-mono text-xs font-bold uppercase tracking-wider rounded hover:opacity-90 transition-all shadow-md\"\n            >\n              ACKNOWLEDGE & INJECT FINDINGS\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }

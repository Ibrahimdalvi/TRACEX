  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \'express\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport { createServer as createViteServer } from \'vite\';\nimport { GoogleGenAI } from \'@google/genai\';\nimport dotenv from \'dotenv\';\n\ndotenv.config();\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nconst PORT = 3000;\n\nlet geminiClient: GoogleGenAI | null = null;\nfunction getGeminiClient(): GoogleGenAI | null {\n  if (!geminiClient && process.env.GEMINI_API_KEY) {\n    geminiClient = new GoogleGenAI({\n      apiKey: process.env.GEMINI_API_KEY,\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        },\n      },\n    });\n  }\n  return geminiClient;\n}\n\nasync function startServer() {\n  const app = express();\n  app.use(express.json());\n\n  // Health check endpoint\n  app.get(\'/api/health\', (req, res) => {\n    res.json({\n      status: \'online\',\n      system: \'ARGUS Criminal Intel Backend\',\n      geminiConfigured: !!process.env.GEMINI_API_KEY,\n      timestamp: new Date().toISOString(),\n    });\n  });\n\n  // Copilot chat endpoint\n  app.post(\'/api/copilot/chat\', async (req, res) => {\n    try {\n      const { message, contextCaseId, entityId } = req.body;\n      const ai = getGeminiClient();\n\n      if (!ai) {\n        // High fidelity fallback response\n        const fallbackAnswers: Record<string, { answer: string; citations: Array<{ type: string; title: string }> }> = {\n          \'bridge\': {\n            answer: \'Entity P-104 (Rahul Sharma) is currently the strongest bridge entity in this investigation network. Analysis indicates this entity is the sole known conduit connecting the \"Eastern Syndicate\" node cluster with the newly identified \"Harbor Operations\" cluster.\\n\\nThis entity is associated with 6 historical cases, but this is the first time it has appeared linking these two specific groups, indicating a potential merger or joint operation.\',\n            citations: [\n              { type: \'account_balance\', title: \'Bank Records (Tx-992)\' },\n              { type: \'call\', title: \'Call Logs (Intercept A)\' },\n            ],\n          },\n          \'connector\': {\n            answer: \'Target P-104 (Rahul Sharma) holds a Betweenness Centrality score of 0.82 and a Degree score of 17, making him the primary arterial node across 6 active investigations including CN-2026-0142 and CN-2026-0188. Communication traffic spikes occur within 4.2 hours of major overseas wire transfers.\',\n            citations: [\n              { type: \'hub\', title: \'Network Link Analysis V2\' },\n              { type: \'description\', title: \'Surveillance Dossier DOC-881\' },\n            ],\n          },\n          \'subpoena\': {\n            answer: \'Subpoena Draft initiated for Aegis Holdings FZE (ORG-42, DMCC Reg #88412-B) and associated accounts at Falcon Interbank (Acct #XXXX9821). Primary statutory grounds: 18 U.S.C. \302\247 1956 (Money Laundering) and cross-border shell structuring compliance violations.\',\n            citations: [\n              { type: \'policy\', title: \'Statutory Notice Rule 17(c)\' },\n              { type: \'account_balance\', title: \'Financial Audit Report FIN-2026-09\' },\n            ],\n          },\n        };\n\n        const queryLower = (message || \'\').toLowerCase();\n        let matched = fallbackAnswers[\'bridge\'];\n        if (queryLower.includes(\'connector\') || queryLower.includes(\'strongest\')) {\n          matched = fallbackAnswers[\'connector\'];\n        } else if (queryLower.includes(\'subpoena\') || queryLower.includes(\'draft\') || queryLower.includes(\'warrant\')) {\n          matched = fallbackAnswers[\'subpoena\'];\n        } else if (queryLower.includes(\'p-104\') || queryLower.includes(\'rahul\')) {\n          matched = fallbackAnswers[\'bridge\'];\n        } else {\n          matched = {\n            answer: `Analysis of ${contextCaseId || \'CN-2026-0142\'}: Intelligence feeds indicate ongoing transactional and telecommunication linkage centering on Entity P-104. Forensic cross-referencing confirms 17 connected nodes with high anomaly probability (91.4%).`,\n            citations: [\n              { type: \'account_balance\', title: \'Bank Records (Tx-992)\' },\n              { type: \'call\', title: \'Call Logs (Intercept A)\' },\n            ],\n          };\n        }\n\n        return res.json({\n          reply: matched.answer,\n          citations: matched.citations,\n          confidence: 0.942,\n          source: \'ARGUS_LOCAL_ANALYTIC_CORE\',\n        });\n      }\n\n      const systemPrompt = `You are ARGUS COPILOT, an advanced tactical AI assistant embedded in a criminal intelligence and link-analysis command center.\nCurrent Case Context: ${contextCaseId || \'CN-2026-0142\'} (Financial Network Investigation).\nPrimary Subject: P-104 (Rahul Sharma), Director of Aegis Holdings FZE (ORG-42).\nAssociated Entities: Phone (+91 98XXXXXX12), Account (XXXX9821), Vehicle (MH-04-AB-1234), Node (U-881).\nStyle guidelines:\n- Highly concise, forensic, authoritative, and tactical.\n- Frame responses using criminal intelligence terminology (e.g., bridge entity, betweenness centrality, typologies, beneficial ownership, offshore conduit, wire routing).\n- Highlight key identifiers in bold or monospaced terms.\n- Provide supporting evidence citations.`;\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.7-flash\',\n        contents: message,\n        config: {\n          systemInstruction: systemPrompt,\n          temperature: 0.2,\n        },\n      });\n\n      const replyText = response.text || \'Analytics processed. Target P-104 remains high risk.\';\n\n      res.json({\n        reply: replyText,\n        citations: [\n          { type: \'account_balance\', title: \'Bank Records (Tx-992)\' },\n          { type: \'call\', title: \'Call Logs (Intercept A)\' },\n        ],\n        confidence: 0.942,\n        source: \'GEMINI_3.7_FLASH_INTELLIGENCE_ENGINE\',\n      });\n    } catch (err: any) {\n      console.error(\'Copilot API error:\', err);\n      res.status(500).json({\n        error: \'Failed to process copilot query\',\n        details: err?.message || String(err),\n      });\n    }\n  });\n\n  // Deep network scan endpoint\n  app.post(\'/api/intelligence/deep-scan\', async (req, res) => {\n    try {\n      const { caseId } = req.body;\n      const ai = getGeminiClient();\n\n      if (!ai) {\n        return res.json({\n          scanId: `SCAN-${Date.now().toString(36).toUpperCase()}`,\n          nodesAnalyzed: 142,\n          edgesScanned: 318,\n          anomaliesDetected: 4,\n          newBridgeCandidates: [\'P-104 (Rahul Sharma)\', \'ORG-42 (Aegis Holdings FZE)\'],\n          riskLevel: \'CRITICAL\',\n          summary: \'Deep network recursive scan discovered 4 cyclic wire patterns traversing Dubai and Caribbean intermediary accounts.\',\n        });\n      }\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.7-flash\',\n        contents: `Run a deep topological network scan for Case ${caseId || \'CN-2026-0142\'} focusing on money laundering conduits and entity bridges. Summarize findings in 2 tactical bullet points.`,\n        config: {\n          systemInstruction: \'You are an automated criminal network graph analyzer. Respond with concise tactical findings.\',\n        },\n      });\n\n      res.json({\n        scanId: `SCAN-${Date.now().toString(36).toUpperCase()}`,\n        nodesAnalyzed: 142,\n        edgesScanned: 318,\n        anomaliesDetected: 4,\n        newBridgeCandidates: [\'P-104 (Rahul Sharma)\', \'ORG-42 (Aegis Holdings FZE)\'],\n        riskLevel: \'CRITICAL\',\n        summary: response.text,\n      });\n    } catch (err: any) {\n      res.status(500).json({ error: \'Deep scan failed\', details: err?.message });\n    }\n  });\n\n  // Vite middleware in dev / static serve in prod\n  if (process.env.NODE_ENV !== \'production\') {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req, res) => {\n      res.sendFile(path.join(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`ARGUS Criminal Intel Server running on http://localhost:${PORT}`);\n  });\n}\n\nstartServer();\n"
    }

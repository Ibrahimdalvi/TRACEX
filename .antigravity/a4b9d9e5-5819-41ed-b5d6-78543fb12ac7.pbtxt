    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { TimelineEntry, InvestigationCase } from \'../../types\';\n\ninterface TimelineViewProps {\n  timeline: TimelineEntry[];\n  currentCase: InvestigationCase;\n}\n\nexport const TimelineView: React.FC<TimelineViewProps> = ({ timeline, currentCase }) => {\n  const [filterType, setFilterType] = useState<string>(\'ALL\');\n\n  const filtered = timeline.filter((item) => {\n    if (filterType === \'ALL\') return true;\n    return item.type === filterType;\n  });\n\n  return (\n    <div className=\"flex-1 flex flex-col gap-6 overflow-y-auto pr-2 pb-12\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1\">\n            <span className=\"font-mono text-xs text-[#7bd6d1] font-bold uppercase tracking-wider\">\n              {currentCase.id} CHRONOLOGICAL LOG\n            </span>\n          </div>\n          <h2 className=\"font-sans text-2xl sm:text-3xl font-bold text-white tracking-tight\">\n            Temporal Multi-Source Timeline\n          </h2>\n        </div>\n\n        {/* Filter Chips */}\n        <div className=\"flex gap-1.5 bg-[#1a2120] border border-[#3c4948]/40 p-1 rounded\">\n          {[\'ALL\', \'SYSTEM\', \'TRANSACTION\', \'COMMUNICATION\', \'BORDER\'].map((type) => (\n            <button\n              key={type}\n              onClick={() => setFilterType(type)}\n              className={`px-2.5 py-1 rounded font-mono text-[9px] font-bold uppercase tracking-wider transition-colors ${\n                filterType === type\n                  ? \'bg-[#66FCF1] text-[#00201e]\'\n                  : \'text-[#bacac7] hover:text-white\'\n              }`}\n            >\n              {type}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Timeline Stream */}\n      <div className=\"relative border-l-2 border-[#3c4948]/50 ml-4 md:ml-6 pl-6 space-y-6 my-2\">\n        {filtered.map((entry) => {\n          const isHigh = entry.severity === \'high\';\n          return (\n            <div key={entry.id} className=\"relative group\">\n              {/* Timeline Marker Dot */}\n              <div\n                className={`absolute -left-[31px] top-1.5 w-3.5 h-3.5 rounded-full border-2 bg-[#090f0f] ${\n                  isHigh\n                    ? \'border-[#ffb4ab] shadow-[0_0_8px_#ffb4ab]\'\n                    : \'border-[#66FCF1] shadow-[0_0_8px_#66FCF1]\'\n                }`}\n              ></div>\n\n              {/* Event Card */}\n              <div className=\"bg-[#1a2120] border border-[#3c4948]/40 p-4 rounded-lg shadow-sm hover:border-[#66FCF1]/50 transition-colors\">\n                <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <span\n                      className={`font-mono text-[9px] font-bold px-2 py-0.5 rounded uppercase tracking-wider border ${\n                        entry.type === \'TRANSACTION\'\n                          ? \'text-[#dec74a] bg-[#736400]/20 border-[#fce363]/30\'\n                          : entry.type === \'COMMUNICATION\'\n                          ? \'text-[#F6B352] bg-[#F6B352]/10 border-[#F6B352]/30\'\n                          : entry.type === \'BORDER\'\n                          ? \'text-[#ffb4ab] bg-[#93000a]/20 border-[#ffb4ab]/30\'\n                          : \'text-[#7bd6d1] bg-[#007774]/20 border-[#7bd6d1]/30\'\n                      }`}\n                    >\n                      {entry.type}\n                    </span>\n                    <h3 className=\"font-sans text-sm font-bold text-white\">{entry.title}</h3>\n                  </div>\n\n                  <span className=\"font-mono text-[10px] text-[#859491]\">\n                    {entry.timestamp} ({entry.relativeTime})\n                  </span>\n                </div>\n\n                <p className=\"font-sans text-xs text-[#bacac7] leading-relaxed mb-3\">\n                  {entry.description}\n                </p>\n\n                <div className=\"flex items-center gap-2 pt-2 border-t border-[#3c4948]/30 font-mono text-[10px]\">\n                  <span className=\"text-[#859491]\">ENTITIES INVOLVED:</span>\n                  <div className=\"flex flex-wrap gap-1.5\">\n                    {entry.entitiesInvolved.map((ent, idx) => (\n                      <span\n                        key={idx}\n                        className=\"text-[#66FCF1] bg-[#0e1514] px-2 py-0.5 rounded border border-[#3c4948]/50\"\n                      >\n                        {ent}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </div>\n          );\n        })}\n      </div>\n    </div>\n  );\n};\n"
    }

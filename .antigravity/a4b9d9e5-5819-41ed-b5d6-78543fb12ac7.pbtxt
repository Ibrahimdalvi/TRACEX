    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-hanken: \'Hanken Grotesk\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    --font-mono: \'JetBrains Mono\', monospace;\n  }\n\n  body {\n    font-family: var(--font-hanken);\n    background-color: #0B0C10;\n    color: #dde4e2;\n  }\n}\n\n.font-mono, .font-code {\n  font-family: var(--font-mono);\n}\n\n.font-hanken {\n  font-family: var(--font-hanken);\n}\n\n.material-symbols-outlined {\n  font-variation-settings: \'FILL\' 0, \'wght\' 400, \'GRAD\' 0, \'opsz\' 24;\n  vertical-align: middle;\n}\n\n.material-symbols-outlined.fill-1 {\n  font-variation-settings: \'FILL\' 1;\n}\n\n/* Custom Scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: rgba(11, 12, 16, 0.6);\n}\n::-webkit-scrollbar-thumb {\n  background: rgba(69, 162, 158, 0.25);\n  border-radius: 2px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(102, 252, 241, 0.5);\n}\n\n/* Subtle glowing radar sweep */\n@keyframes radar-pulse {\n  0% { transform: scale(0.95); opacity: 0.8; }\n  50% { transform: scale(1.1); opacity: 0.3; }\n  100% { transform: scale(0.95); opacity: 0.8; }\n}\n\n.radar-pulse {\n  animation: radar-pulse 3s infinite ease-in-out;\n}\n\n@keyframes spin-slow {\n  from { transform: rotate(0deg); }\n  to { transform: rotate(360deg); }\n}\n\n.animate-spin-slow {\n  animation: spin-slow 8s linear infinite;\n}\n\n/* Grid background pattern */\n.hud-grid {\n  background-image: linear-gradient(rgba(69, 162, 158, 0.07) 1px, transparent 1px),\n                    linear-gradient(90deg, rgba(69, 162, 158, 0.07) 1px, transparent 1px);\n  background-size: 32px 32px;\n}\n\n.hud-grid-dense {\n  background-image: linear-gradient(rgba(69, 162, 158, 0.05) 1px, transparent 1px),\n                    linear-gradient(90deg, rgba(69, 162, 158, 0.05) 1px, transparent 1px);\n  background-size: 16px 16px;\n}\n"
    }
